# GEMINI_API_KEY: Required for the Skyplan AI planning agent (tool-calling + multilingual explanations).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Optional. Create a bot with @BotFather on Telegram to receive
# sudden forecast change alerts for your tracked events.
TELEGRAM_BOT_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000
